# Application
APP_NAME=Plexo
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://plexo:plexo@localhost:5432/plexo
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# KuzuDB (Graph Database for Embeddings)
KUZU_DB_PATH=./data/kuzu

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_AGENTS=plexo.agents
RABBITMQ_QUEUE_TASKS=plexo.tasks
RABBITMQ_QUEUE_BACKGROUND=plexo.background

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# SPADE (XMPP)
XMPP_SERVER=localhost
XMPP_PORT=5222
XMPP_DOMAIN=localhost
XMPP_ADMIN_JID=admin@localhost
XMPP_ADMIN_PASSWORD=admin

# LangChain
OPENAI_API_KEY=sk-your-openai-api-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Workers
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4