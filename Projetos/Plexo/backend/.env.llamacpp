# LLama.cpp Configuration
# TurboQuant CUDA - RTX 4060 8GB VRAM

# Model path
LLAMACPP_MODEL_PATH=/home/levybonito/.lmstudio/models/Jackrong/Qwen3.5-4B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF/Qwen3.5-4B.Q4_K_M.gguf

# Binary path (compiled turbo3-cuda)
LLAMACPP_BINARY_PATH=/tmp/turbo3-cuda/build/bin/llama-server

# Server configuration
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8081
LLAMACPP_TIMEOUT=300

# === MAXIMUM PERFORMANCE SETTINGS ===

# Context size - 64K (optimized for RTX 4060 8GB VRAM)
LLAMACPP_CTX_SIZE=65536

# GPU layers - ALL layers on GPU
LLAMACPP_GPU_LAYERS=99

# Batch size for prompt processing
LLAMACPP_BATCH_SIZE=1024

# Micro-batch size for generation
LLAMACPP_UBATCH_SIZE=512

# CPU threads - MAXIMUM
LLAMACPP_THREADS=16

# Parallel sequences for concurrent requests
LLAMACPP_PARALLEL=2

# === TURBOQUANT KV CACHE COMPRESSION ===
LLAMACPP_FLASH_ATTN=true

# === TOKEN EFFICIENCY OPTIMIZATIONS ===
LLAMACPP_CONT_BATCHING=true
LLAMACPP_MLOCK=true
LLAMACPP_USE_MMAP=true
LLAMACPP_NO_KV_OFFLOAD=false

# === SAMPLING PARAMETERS ===
LLAMACPP_TEMPERATURE=0.7
LLAMACPP_TOP_P=0.9
LLAMACPP_TOP_K=40
LLAMACPP_REPEAT_PENALTY=1.1
LLAMACPP_MAX_TOKENS=4096